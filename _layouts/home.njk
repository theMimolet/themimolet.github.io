---
layout: default
---

<section>
    <!-- Description -->

    <div id="welcome">
        {{ content | safe }}
    </div>

    <!-- Pfp + Citation -->

    <div id="pfp-container">
        <img src="{{ site.images_path }}/mimo-pfp.png" class="pfp"
            alt="{{ i18n[lang].profile_picture_alt }}">
        <p id="citation">"Say cheese !"</p>
    </div>
</section>


<!-- Links to my socials -->

<div id="socials" aria-label="Social links">
    {% for social in home.socials %}
    <a href="{{ social.url }}" title="{{ social.name }}">
        <img src="{{ site.icons_path }}/socials/{{ social.name | lower }}.svg"
            alt="{{ i18n[lang].social }} {{ social.name }}"
            target="_blank" rel="noopener noreferrer">
    </a>
    {% endfor %}
</div>